# SIEM Environment Configuration
# Copy this file to .env and configure your settings

# ---------------------------------------------------------------------------
# AI SOC Agent - LLM provider (all optional)
#
# Without any key set, the AI SOC Agent automatically uses a deterministic,
# template-based root cause analysis - no key required for the core demo.
#
# Set ANY ONE of the keys below to enable LLM-mode RCA and natural-language
# search queries. If more than one is set, the agent picks the first match
# in this order: Groq, OpenAI, Anthropic, Gemini - unless you set AI_PROVIDER
# to force a specific one.
# ---------------------------------------------------------------------------

# Groq (free tier available) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Force a specific provider when multiple keys above are set.
# One of: groq | openai | anthropic | gemini
AI_PROVIDER=

# Optional: override the default model for whichever provider is active.
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# OpenSearch Configuration (Optional - defaults shown)
# ---------------------------------------------------------------------------
OPENSEARCH_HOST=opensearch-node
OPENSEARCH_PORT=9200

# ---------------------------------------------------------------------------
# API security (Optional - the demo runs fully open by default)
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed to call the API from a browser.
# Defaults to the local React dev/demo server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave empty for the open demo (no auth). Set a value to require callers to
# send a matching `X-API-Key` header on write endpoints (ingest, rule
# creation, incident actions, AI, response actions). If you set this, also
# set VITE_API_KEY (below) to the same value so the React UI keeps working.
SIEM_API_KEY=

# Read by the React UI build (frontend/react-ui) - must match SIEM_API_KEY
# above when auth is enabled.
VITE_API_KEY=

# When false, the ingestion-api process does not run its own
# detection/correlation background loops - it relies on the standalone
# detection-engine/correlation-engine containers instead. docker-compose.yml
# sets this to false. Leave it true (default) for a bare `uvicorn main:app`
# run with no standalone engine containers.
RUN_ENGINES_IN_API=true
