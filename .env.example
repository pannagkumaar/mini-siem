# SIEM Environment Configuration
# Copy this file to .env and configure your settings

# Groq API Configuration (Required for AI Agent)
GROQ_API_KEY=your_groq_api_key_here

# OpenSearch Configuration (Optional - defaults shown)
OPENSEARCH_HOST=opensearch-node
OPENSEARCH_PORT=9200

# Example: Get your free Groq API key from https://console.groq.com/keys
# Then replace "your_groq_api_key_here" with your actual key